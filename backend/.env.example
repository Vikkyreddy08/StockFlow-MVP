# =========================================================
# StockFlow MVP - Backend Environment Variables (EXAMPLE)
# =========================================================
# Copy this file to `.env` and replace the placeholder values:
#     Copy-Item .env.example .env
# NEVER commit the real `.env` file or real credentials.

# ---------- Django ----------
# Generate a new key, e.g.:
#   py -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- MySQL Database ----------
# Leave MYSQL_DATABASE empty (or remove it) to fall back to SQLite.
MYSQL_DATABASE=stockflow
MYSQL_USER=stockflow_user
MYSQL_PASSWORD=replace-with-your-db-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---------- CORS ----------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
